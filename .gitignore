# User-owned source media and extraction intermediates (never deploy/publish)
N2_somatome/
N2/
tmp/
scratchpad/
data/bot-toc/
std/
scratch_*.png
scratch_*.jpg
scratch_*.jpeg
scratch_*.js

# Scratch/staging area for files pending manual deletion (repo cleanup)
_cleanup_trash/

# Local editor / OS state
.vscode/
.DS_Store
Thumbs.db

# Python / Node caches
__pycache__/
*.py[cod]
node_modules/
test-results/
playwright-report/

# Resumable Gemini extraction checkpoints; canonical JSON is tracked instead
data/book/*.draft.json
data/book/*.tmp

# Exam answer keys (answerIndex/referenceNote) — the entire point of
# exam_content's zero-client-policy RLS + exam-fetch's server-side answer
# stripping is that these never reach the browser before/during a test.
# Committing the canonical JSON defeats that outright: this repo is public,
# so anyone could read every sitting's correct answers straight from git
# history. Only the DB (loaded via scripts/load-exam.mjs) is canonical now.
data/exams/*.json
data/exams/*.draft.json
data/exams/*.tmp

# Local secrets (Supabase project keys, DB password). Never commit.
.env
.env.local
.env.*.local
supabase/.branches
supabase/.temp
# config.json is tracked: it holds only PUBLIC Supabase credentials
# (anon key + project URL). RLS keeps the data locked. Secret keys live in .env.local.
