{
  "name": "n2-web-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:vendor": "node scripts/build-vendor.mjs",
    "build:models": "node scripts/generate-pet-models.mjs",
    "build:pets": "node scripts/build-pet-atlas.mjs",
    "validate:data": "node scripts/validate-book-data.mjs",
    "check": "npm test && npm run validate:data",
    "verify:schema": "node scripts/verify-schema.mjs",
    "deploy:supabase": "node scripts/link-and-deploy.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "ffmpeg-static": "^5.3.0",
    "pg": "8.13.3",
    "three": "0.185.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2"
  }
}
